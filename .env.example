# ── Auth.js v5 ─────────────────────────────────────────────
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth — https://console.cloud.google.com/apis/credentials
#   Redirect URI: https://<dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth — https://github.com/settings/developers
#   Callback URL: https://<dominio>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Datos ──────────────────────────────────────────────────
# Lo usa el backend (Prisma). El frontend no se conecta a la BD.
DATABASE_URL=

# true = adaptador mock en el navegador (desarrollo/pruebas sin backend).
# En producción DEBE ser false.
NEXT_PUBLIC_USE_MOCKS=false
# Opcional: URL del backend si no comparte origen con el frontend.
NEXT_PUBLIC_API_URL=
