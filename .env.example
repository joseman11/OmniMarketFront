# Backend origin reachable from the Next.js server. Local default is the API service.
# Railway: use the backend service's private URL when both services share a project/network.
OMNIMARKET_API_URL=http://localhost:3001

# true enables browser-local mock data. Keep false for Railway and real API integration.
NEXT_PUBLIC_USE_MOCKS=false

# Optional server-only secret shared with the backend. Used only by the confirmed,
# admin-protected fixture reset endpoint (/api/internal/test-reset).
TEST_API_TOKEN=

# Explicit switch for fixture deployments: the reset route answers 404 unless this is "true".
TEST_RESET_ENABLED=
